#!/bin/bash
set -euo pipefail

USER_TOKEN_JSON="/ts/etc/user_token.json"
ADMIN_TOKEN_JSON="/ts/etc/admin_token.json"

IMG="/thinstation.img"
IMG_SIZE="12G"

die(){ echo "ERROR: $*" >&2; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"; }

need parted; need cryptsetup; need losetup; need truncate; need mkfs.vfat
need pvcreate; need vgcreate; need lvcreate; need mkfs.ext4; need lsblk

if [[ $EUID -ne 0 ]]; then
  die "Must run as root."
fi

# ---- Pick disk or loop fallback ----
loop=""
if [ -z "${1:-}" ]; then
  rm -f "$IMG"
  truncate -s "$IMG_SIZE" "$IMG"
  loop="$(losetup -f)"
  losetup -P "$loop" "$IMG"
  DISK="$loop"
else
  DISK="$1"
fi

[ -b "$DISK" ] || die "Not a block device: $DISK"

# Partition suffix: nvme0n1p1 / loop0p1 / mmcblk0p1 etc.
p=""
[[ "$DISK" =~ [0-9]$ ]] && p="p"

# ---- Interactive token entry ----
read -r -s -p "Enter USER LUKS passphrase (required): " USER_TOKEN
echo
[ -n "$USER_TOKEN" ] || die "USER passphrase cannot be empty."

read -r -s -p "Enter ADMIN LUKS passphrase (optional, press Enter to skip): " ADMIN_TOKEN
echo

# ---- Unmount anything mounted from this disk ----
mapfile -t mps < <(lsblk -nrpo MOUNTPOINT "$DISK" | awk 'NF')
for mp in "${mps[@]}"; do
  umount "$mp" || true
done

# ---- Partitioning ----
parted "$DISK" --script mklabel gpt

# 2GiB FAT32 (ESP/boot)
parted "$DISK" --script mkpart primary fat32 1MiB 2GiB
parted "$DISK" --script set 1 esp on

# LUKS partition (rest)
parted "$DISK" --script mkpart primary 2GiB 100%
parted "$DISK" --script name 2 SafeStore

partprobe "$DISK" || true
#udevadm settle || true

mkfs.vfat -F 32 "${DISK}${p}1" -n boot

# ---- LUKS format (user passphrase) ----
printf '%s' "$USER_TOKEN" | cryptsetup luksFormat -q --type luks2 --pbkdf pbkdf2 --batch-mode --force-password "${DISK}${p}2" --key-file -

# Import user token JSON (if present)
if [ -f "$USER_TOKEN_JSON" ]; then
  cryptsetup token import --token-id 0 "${DISK}${p}2" --json-file "$USER_TOKEN_JSON"
else
  echo "Warning: missing $USER_TOKEN_JSON, skipping user token import" >&2
fi

# ---- Optional ADMIN key add (no temp files) ----
if [ -n "$ADMIN_TOKEN" ]; then
  if cryptsetup luksAddKey --help 2>&1 | grep -q -- '--new-keyfile'; then
    # Provide old key then new key on stdin in that order
    {
      printf '%s\n' "$USER_TOKEN"
      printf '%s' "$ADMIN_TOKEN"
    } | cryptsetup luksAddKey "${DISK}${p}2" \
        --key-file - \
	--type luks2 \
	--pbkdf pbkdf2 \
	--force-password \
        --new-keyfile - \
        --key-slot 1 \
        --batch-mode
  else
    # Fallback (prompt-driven) – depends on cryptsetup prompt order
    {
      printf '%s\n' "$USER_TOKEN"
      printf '%s\n' "$ADMIN_TOKEN"
      printf '%s\n' "$ADMIN_TOKEN"
    } | cryptsetup luksAddKey --type luks2 --pbkdf pbkdf2 --force-password "${DISK}${p}2" --key-slot 1 --batch-mode
  fi

  if [ -f "$ADMIN_TOKEN_JSON" ]; then
    cryptsetup token import --token-id 1 "${DISK}${p}2" --json-file "$ADMIN_TOKEN_JSON"
  else
    echo "Warning: missing $ADMIN_TOKEN_JSON, skipping admin token import" >&2
  fi
fi

# ---- Open LUKS (user passphrase) ----
printf '%s' "$USER_TOKEN" | cryptsetup open "${DISK}${p}2" cryptdisk --key-file - --batch-mode

# ---- LVM ----
pvcreate /dev/mapper/cryptdisk
vgcreate vg_crypt /dev/mapper/cryptdisk

lvcreate -L 1G -n lv_prstnt vg_crypt
lvcreate -L 2G -n lv_log    vg_crypt
lvcreate -L 1G -n lv_root   vg_crypt
lvcreate -L 4G -n lv_home   vg_crypt
lvcreate -l 100%FREE -n lv_tsdev vg_crypt

mkfs.ext4 /dev/vg_crypt/lv_prstnt
mkfs.ext4 /dev/vg_crypt/lv_log
mkfs.ext4 /dev/vg_crypt/lv_root
mkfs.ext4 /dev/vg_crypt/lv_home
mkfs.ext4 /dev/vg_crypt/lv_tsdev

e2label /dev/vg_crypt/lv_prstnt prstnt
e2label /dev/vg_crypt/lv_log    log
e2label /dev/vg_crypt/lv_root   root
e2label /dev/vg_crypt/lv_home   home
e2label /dev/vg_crypt/lv_tsdev  tsdev

# ---- Close up ----
vgchange -an vg_crypt || true
cryptsetup close cryptdisk

mount "${DISK}${p}1" /mnt
cp -a /build/boot-images/grub/efi-source/* /mnt
umount /mnt

if [ -n "${loop:-}" ]; then
  losetup -d "$loop"
fi

echo "Partitioning, LUKS, and LVM setup complete."
